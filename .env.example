# Copy to .env.local and fill in. Both are server-only — deliberately not
# NEXT_PUBLIC_, so neither reaches the browser.

# Momm's Convex deployment, which lives in the momm-app repo. This is the HTTP
# actions domain (.convex.site), NOT the client domain (.convex.cloud).
# Dev: https://harmless-pelican-636.convex.site
CONVEX_SITE_URL=

# Shared secret guarding POST /waitlist. Must match the value set on the
# deployment itself, from momm-app/:
#   npx convex env set WAITLIST_INGEST_SECRET <value>
WAITLIST_INGEST_SECRET=
